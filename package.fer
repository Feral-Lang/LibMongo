let vec = import('std/vec');
let package = import('std/package');

let configure = fn(info) {
    let pkg = package.new(
        'Mongo',
        desc = 'Mongo DB (and BSON) bindings for Feral using the Mongo-C-Driver library.',
        version = '0.2.1',
        feral = '>=2.6.0',
        author = vec.new('Chirag-Khandelwal <github@mail.chiragkh.me>')
    );

    pkg.requires('bson2', version = '>=2.3.0');
    pkg.requires('mongoc2', version = '>=2.3.0');

    let bsonTarget = pkg.addTarget('Bson');
    bsonTarget.addHeaders(info.pkgRoot / 'lib' / 'Bson.hpp');
    bsonTarget.addSources(info.pkgRoot / 'lib' / 'Bson.cpp');

    let mongoTarget = pkg.addTarget('Mongo');
    mongoTarget.requires(bsonTarget);
    mongoTarget.addHeaders(info.pkgRoot / 'lib' / 'Mongo.hpp');
    mongoTarget.addSources(info.pkgRoot / 'lib' / 'Mongo.cpp');

    return feral.ok(pkg);
};